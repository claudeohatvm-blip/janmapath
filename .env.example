# Copy to .env and fill in. Never commit the real file.
#
# AI narration is OPTIONAL. Without any key the report is written from rules,
# in English, and every placement, score and conclusion is identical.
# See docs/AI_SETUP.md or the "AI setup" page in the running app.

# --- Google Gemini, via AI Studio -------------------------------------------
# Free tier, no card required: https://aistudio.google.com/apikey
# Keys start with either "AQ." (current) or "AIza" (legacy). Both work.
GEMINI_API_KEY=

# Optional. Default: gemini-3.6-flash
# Google retires model IDs over time. If a request 404s with "no longer
# available", open /setup/ai and click "Check models" to see what this key
# can reach, then set it here.
# GEMINI_MODEL=gemini-3.8-flash

# --- Anthropic Claude --------------------------------------------------------
# https://console.anthropic.com  (prepaid credit required)
# ANTHROPIC_API_KEY=

# Optional. Default: claude-opus-5
# ANTHROPIC_MODEL=claude-opus-5

# --- Which provider to use ---------------------------------------------------
# auto (default) uses whichever has a key, preferring Gemini.
# Set to "gemini", "anthropic", or "none" to pin the choice.
# AI_PROVIDER=auto
